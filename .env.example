# הכתובת הציבורית של המערכת (בלי / בסוף). ממנה נבנית כתובת החזרה של Google:
# <APP_URL>/api/auth/google/callback
APP_URL=http://localhost:3000

# סיסמת הכניסה למערכת (בעל המערכת בלבד)
ADMIN_PASSWORD=

# מחרוזת אקראית ארוכה (32 תווים לפחות). מצפינה את הרשאות Google ששמורות במסד
# וחותמת את עוגיית הכניסה. החלפה שלה מנתקת את כל החשבונות המחוברים.
APP_SECRET=

# Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# מפתח ל-Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
# המודל שמזהה חשבוניות ומציע חלופות
CLAUDE_MODEL=claude-opus-5-5

# כמה חודשים אחורה לסרוק בכל חשבון
SCAN_MONTHS=12

# איפה נשמר קובץ מסד הנתונים (SQLite)
DATA_DIR=./data
